# Copy to .env and fill in values — never commit .env

# Database
DB_HOST=postgres-db
DB_PORT=5432
DB_NAME=srave_prod
DB_USER=srave_user
DB_PASSWORD=

# Redis
REDIS_URL=redis://redis-cache:6379

# Auth (JWT)
JWT_SECRET=
JWT_EXPIRY_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800

# Client credentials are now stored in the `clients` DB table.
# Seed an initial admin client after first migration:
#   INSERT INTO clients (id, secret_hash, scope)
#   VALUES ('admin_01', '<bcrypt_hash>', 'admin');
# Then use POST /api/v1/auth/token to obtain a JWT.

# Internal service URLs
SPATIAL_SERVICE_URL=http://spatial-worker:8001
BILLING_SERVICE_URL=http://billing-worker:8002
VOICE_SERVICE_URL=http://voice-service:8004

# WhatsApp Business Cloud API
WA_API_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=

# Payments
FLUTTERWAVE_SECRET_KEY=
PAYSTACK_SECRET_KEY=

# Google Earth Engine
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=/run/secrets/gee_key.json

# Multilateral signing
SIGNING_KEY_PATH=/run/secrets/signing.key
PILOT_LGA=Ogun State LGAs

# Monitoring
GRAFANA_PASSWORD=
FLOWER_USER=admin
FLOWER_PASSWORD=

# Job TTLs (seconds)
JOB_TTL_COMPLETE_SECONDS=21600
JOB_TTL_FAILED_SECONDS=86400
