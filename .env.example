# Copy to .env and fill in values — never commit .env

# Database
DB_HOST=pgbouncer
DB_PORT=5432
DB_NAME=srave_prod
DB_USER=srave_user
DB_PASSWORD=

# Redis
REDIS_URL=redis://redis-cache:6379

# Auth (JWT)
JWT_SECRET=
JWT_EXPIRY_SECONDS=3600

# Client credentials
MUNICIPAL_CLIENT_ID=
MUNICIPAL_CLIENT_SECRET=
FIELD_AGENT_CLIENT_ID=
FIELD_AGENT_CLIENT_SECRET=
MULTILATERAL_CLIENT_ID=
MULTILATERAL_CLIENT_SECRET=
ADMIN_CLIENT_ID=
ADMIN_CLIENT_SECRET=

# Internal service URLs
SPATIAL_SERVICE_URL=http://spatial-worker:8001
BILLING_SERVICE_URL=http://billing-worker:8002
VOICE_SERVICE_URL=http://voice-service:8004

# WhatsApp Business Cloud API
WA_API_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=

# Payments
FLUTTERWAVE_SECRET_KEY=
PAYSTACK_SECRET_KEY=

# Google Earth Engine
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=/run/secrets/gee_key.json

# PlanetScope (optional — 3m resolution, set source=planetscope on ingest)
PLANET_API_KEY=

# Multilateral signing
SIGNING_KEY_PATH=/run/secrets/signing.key
PILOT_LGA=Abeokuta South

# Dashboard
API_BASE_URL=http://srave-api:8080
NEXT_PUBLIC_LGA_ID=Abeokuta South

# Monitoring
GRAFANA_PASSWORD=
FLOWER_USER=admin
FLOWER_PASSWORD=

# Photo storage
PHOTO_STORAGE_BACKEND=local
# Set to "s3" for production object storage
# PHOTO_STORAGE_BACKEND=s3
PHOTO_STORAGE_PATH=/data/photos
PHOTO_S3_BUCKET=
PHOTO_S3_REGION=us-east-1
PHOTO_S3_PREFIX=field-photos
# AWS credentials (if using S3 backend)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
