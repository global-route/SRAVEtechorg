# Copy to .env and fill in real values — never commit .env

# Database
DB_HOST=postgres-db
DB_PORT=5432
DB_NAME=srave_prod
DB_USER=srave_user
DB_PASSWORD=

# Redis
REDIS_HOST=redis-cache
REDIS_PORT=6379

# Auth
JWT_SECRET=
JWT_EXPIRY_SECONDS=3600

# WhatsApp Business Cloud API
WA_API_TOKEN=
WA_PHONE_NUMBER_ID=

# Payments
FLUTTERWAVE_SECRET_KEY=
PAYSTACK_SECRET_KEY=

# Google Earth Engine
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=/run/secrets/gee_key.json

# Multilateral signing
SIGNING_KEY_PATH=/run/secrets/signing.key
